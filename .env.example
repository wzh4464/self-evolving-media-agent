# 复制为 .env 并填入真实值； chmod 600 .env
# .env 已在 .gitignore 中，不会被提交

# --- 媒体库 ---
MEDIA_ROOT=/Volumes/Backup/webdav/Media

# --- qBittorrent (经 gluetun 转发) ---
QBIT_URL=http://127.0.0.1:1122
QBIT_USER=zihan
QBIT_PASS=

# --- AutoBangumi ---
AB_URL=http://127.0.0.1:7892
AB_USER=zihan
AB_PASS=
AB_DB=/Volumes/Backup/webdav/Media/.autobangumi/ab-data/data.db
AB_CONTAINER=autobangumi
DOCKER_BIN=/usr/local/bin/docker

# --- TMDB (themoviedb.org/settings/api 免费申请) ---
TMDB_API_KEY=
TMDB_LANG=zh-CN

# --- LLM (openlux) ---
LLM_BASE=https://api.openlux.ai
LLM_KEY=
# OpenLux 的短别名常报「分组 default 下无可用渠道」503，一律用带日期的完整 id
LLM_MODEL=gpt-5.6-luna-2026-07-09

# --- 行为 ---
# 全自动模式：改名/打标签/分类自动执行，删除走隔离区
AUTO_APPLY=true
# 隔离区保留天数。到期后 run 只删特典 / 菜单 / PV、死种的 .!qB 半成品，以及证明得了替代者的判重；
# 合并发布的另一版本、手动删除、没有隔离记录的永不自动删（run.log 里列出来交给人）
TRASH_RETENTION_DAYS=30
# 最短隔离期（天）：不满这么多天的一律不硬删，purge --apply 提前放行判重时也一样（回退还要用它们）
QUARANTINE_MIN_AGE_DAYS=3
# 媒体卷剩余空间低于这么多 GB 时（隔离区与媒体在同一个 APFS 容器，隔离不腾空间），run 大声告警，
# 并在"已证明可删"的判重里从最老的开始提前删，直到回到阈值以上；证明不了的一个都不为空间删
MIN_FREE_GB=50
# 单次运行删除上限（超过则跳过并告警，防止规则出错批量误删）
MAX_DELETE_PER_RUN=50
MAX_DELETE_GB_PER_RUN=200
# 死种判定：0 seed + 0 availability 且停滞超过这么多小时
DEAD_TORRENT_HOURS=48
# 抓取加种后等元数据最多多少秒（等到了就在下载中改成规范名，等不到交给下一轮的改名规则）；
# 每次等的结局（ready / timeout、等了多久、最后一次报错）写进抓取审计的 metadata 字段
GRAB_METADATA_TIMEOUT=30
# 自演进：off（默认）= 冻结，run 不跑演进、不调 LLM、不往 .agents/ 写任何东西；
# propose = run 末尾找规则盲区 → LLM 提议 → 影子验证 → 写入 .agents/rules/ 并挂载
# （演进规则带的动作一律不自动执行）。按 git tag 部署时，.agents/ 下未入库的新文件
# 会让 deploy.sh 的漂移闸门拒绝部署——要开就得把产出提交入库、打 tag 再部署。
EVOLVE_MODE=off
# qBittorrent 登录成功却报 0 个种子、而媒体库里有视频时，本轮按"数据不完整"整轮拒绝改动
# （多半是 qBit 的会话没恢复，比如容器重建时丢了 BT_backup）。库里确实一个种子都不用才设 1。
QBIT_ALLOW_EMPTY=0
