<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.zihan.media-agent</string>

  <!-- 直接跑 venv 里的入口，不经 `uv run`：uv run 每轮都会按 uv.lock 同步环境，
       锁文件一变就在凌晨联网装依赖（生产 uv 0.7.2），PyPI 不通这一轮就起不来。
       依赖只在部署时由 deploy.sh 按锁文件原样装好（uv sync 的 frozen 模式，critic §3.7）。
       运行锁由 media-agent 自己在 state/run.lock 上拿，不需要外层包装。 -->
  <key>ProgramArguments</key>
  <array>
    <string>/Users/zihan/media-agent/.venv/bin/media-agent</string>
    <string>run</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/zihan/media-agent</string>

  <!-- 每 6 小时一轮 -->
  <key>StartInterval</key>
  <integer>21600</integer>

  <key>StandardOutPath</key>
  <string>/Users/zihan/media-agent/state/run.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/zihan/media-agent/state/run.err.log</string>

  <key>RunAtLoad</key>
  <false/>

  <!-- 低优先级，不跟下载/播放抢 IO -->
  <key>Nice</key>
  <integer>10</integer>
  <key>LowPriorityIO</key>
  <true/>
</dict>
</plist>
